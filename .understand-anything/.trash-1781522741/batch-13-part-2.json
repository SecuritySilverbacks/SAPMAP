        "exploit",
        "windows-lpe",
        "csharp"
      ],
      "complexity": "complex",
      "languageNotes": "Uses NtApiDotNet and unmanaged Win32 P/Invoke (cldapi.dll, advapi32) to coordinate the cldflt mini-filter driver race."
    },
