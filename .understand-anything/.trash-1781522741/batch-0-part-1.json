      "id": "file:modules/core/sapmap_findings.py",
      "type": "file",
      "name": "sapmap_findings.py",
      "filePath": "modules/core/sapmap_findings.py",
      "summary": "Module-global findings bus that decouples the discovery and exploit modules from the GUI: any code can call emit_finding(severity, node, msg) and registered listeners receive the dict in real time, with a 60-second dedupe window and 500-entry ring buffer.",
      "tags": ["event-bus", "findings", "pubsub", "thread-safe"],
      "complexity": "moderate",
      "languageNotes": "Module-level state (lock, listeners list, ring buffer) rather than a class so any subsystem can import and emit without owning a singleton handle."
    },
