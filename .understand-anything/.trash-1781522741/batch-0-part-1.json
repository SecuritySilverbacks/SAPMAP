      "id": "file:modules/core/sapmap_diff.py",
      "type": "file",
      "name": "sapmap_diff.py",
      "filePath": "modules/core/sapmap_diff.py",
      "summary": "Computes a structured delta between two SAPMAPState snapshots (added/removed/changed SAP nodes, findings, RFC connections, cloud connectors, trust chains, created users) and renders the diff as Markdown or self-contained HTML matching the engagement-report visual language.",
      "tags": ["diff", "reporting", "state-comparison", "html-render", "markdown-render"],
      "complexity": "complex",
      "languageNotes": "Three parallel renderers (compute_state_diff plus build_diff_markdown and build_diff_html) all share a small set of identity-key helpers (_conn_key, _finding_key) so a single matching algorithm drives both renderings."
    },
    {
