      "name": "compute_state_diff",
      "filePath": "modules/core/sapmap_diff.py",
      "lineRange": [145, 328],
      "summary": "Walks two SAPMAPState instances and produces the canonical delta dictionary used by every diff renderer: added/removed/changed SAP nodes, findings, RFC connections, SCC nodes, and trust chains.",
      "tags": ["diff", "state-comparison", "core-algorithm"],
      "complexity": "complex"
    },
    {
