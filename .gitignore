*.pfx

# MiniPlasma build artefacts — NuGet restore output, MSBuild outputs,
# ConfuserEx download cache.  The shipped binary lives in
# modules/exploitation/_miniplasma_blob.py; everything under tools/
# is per-build-host transient.
tools/miniplasma/packages/
tools/miniplasma/src/bin/
tools/miniplasma/src/obj/
tools/miniplasma/confuser/
tools/miniplasma/nuget.exe

# GodPotato build artefacts — cloned upstream source + MSBuild outputs
# + ConfuserEx download cache.  The shipped binary lives in
# modules/exploitation/_godpotato_blob.py.
tools/godpotato/src/upstream/
tools/godpotato/confuser/
tools/godpotato/ConfuserEx.crproj
tools/godpotato/confuser.zip

# EfsPotato build artefacts — same layout as GodPotato.  Shipped
# binary lives in modules/exploitation/_efspotato_blob.py.
tools/efspotato/src/upstream/
tools/efspotato/confuser/
tools/efspotato/confuser.zip
