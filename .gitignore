__pycache__/
*.pyc
*.pyo
states/
.claude/
dev_rfc.log
*.sapmap
*.log
# MCP server / VSP (contains credentials)
.mcp.json
.vsp.json
vsp
# Binary files / SDKs
nwrfcsdk/
.DS_Store
*.webarchive
# Lab/user-specific target lists — may contain internal IPs/hostnames
targets.txt
loot/
# Local settings — contains API keys, never push to git
settings.local.json
# Sensitive key material — never push to git
*.p12
*.jks
*.pfx

# MiniPlasma build artefacts — NuGet restore output, MSBuild outputs,
# ConfuserEx download cache.  The shipped binary lives in
# modules/exploitation/_miniplasma_blob.py; everything under tools/
# is per-build-host transient.
tools/miniplasma/packages/
tools/miniplasma/src/bin/
tools/miniplasma/src/obj/
tools/miniplasma/confuser/
tools/miniplasma/nuget.exe

# GodPotato build artefacts — cloned upstream source + MSBuild outputs
# + ConfuserEx download cache.  The shipped binary lives in
# modules/exploitation/_godpotato_blob.py.
tools/godpotato/src/upstream/
tools/godpotato/confuser/
tools/godpotato/ConfuserEx.crproj
tools/godpotato/confuser.zip

# EfsPotato build artefacts — same layout as GodPotato.  Shipped
# binary lives in modules/exploitation/_efspotato_blob.py.
tools/efspotato/src/upstream/
tools/efspotato/confuser/
tools/efspotato/confuser.zip

# SSFS decrypt — Java build outputs.  Ship the source under
# tools/ssfs_decrypt/src/; the .jar + Gradle build/ directory
# are reproducible artefacts.
tools/ssfs_decrypt/build/
tools/ssfs_decrypt/*.jar

# Accidentally-captured CLI help output (e.g. `cf ssh --help`
# redirected into a file by mistake).  Should be re-generated
# from the CLI when needed.
tools/btp_ssh_bridge/sapmap-probe-bridge

# Proprietary SAP binaries (SNC libraries, etc).  SAP licenses
# these to customers under their EULA — must NEVER be pushed to
# a public repo.  Mirrors the pre-existing `nwrfcsdk/` rule.
libsapscc*.dylib
libsapscc*.so
libsapscc*.dll
sapcrypto*.dylib
sapcrypto*.so
sapcrypto*.dll

# SAP Notes (KBAs) downloaded from SAP for Me — licensed SAP
# content, customer-only access.  Match the naming pattern
# SAP's portal uses: <7-digit ID>_<lang>_<YYYYMMDD>.pdf.
[0-9][0-9][0-9][0-9][0-9][0-9][0-9]_*_[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9].pdf

# Large media (demo recordings, build pitch decks).  Keep these
# off git — they bloat the repo permanently and either exceed
# GitHub's 100 MB hard limit or get rejected with warnings.
# Host video/slides externally (e.g. company drive) and link
# from docs/ if reference is needed.
*.mov
*.mp4
*.pptx
*.key
