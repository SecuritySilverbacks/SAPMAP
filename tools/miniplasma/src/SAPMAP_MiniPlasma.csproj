<Project Sdk="Microsoft.NET.Sdk">

  <!--
    SAPMAP-modified MiniPlasma - Windows LPE via cldflt race.
    Build via tools/miniplasma/build.ps1 (Windows + msbuild + ConfuserEx).

    SDK-style csproj: MSBuild auto-restores PackageReference items from
    the global NuGet cache (no packages.config, no HintPaths).  Costura
    .Fody embeds NtApiDotNet + Microsoft.Win32.TaskScheduler into a
    single self-contained mp_bin.exe.

    Output: bin\Release\net472\mp_bin.exe
            (ConfuserEx then post-processes into ..\confused\mp_bin.exe)
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <RootNamespace>SAPMAP_MiniPlasma</RootNamespace>
    <AssemblyName>mp_bin</AssemblyName>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Deterministic>true</Deterministic>
    <!-- Costura merges everything; debug symbols off so the shipped
         binary is smaller and harder to reverse. -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <!-- Costura.Fody: embeds dependencies into the main .exe at compile
         time.  PrivateAssets="all" means the Costura attribute doesn't
         leak into mp_bin.exe's metadata. -->
    <PackageReference Include="Costura.Fody" Version="6.2.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Fody" Version="6.9.3">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- The real exploit dependencies.  Costura merges these into
         mp_bin.exe so the target doesn't need them side-loaded. -->
    <PackageReference Include="NtApiDotNet" Version="1.1.33" />
    <PackageReference Include="TaskScheduler" Version="2.12.2" />
  </ItemGroup>

</Project>
